---
import "@fontsource-variable/unbounded";
import "@fontsource-variable/golos-text";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Кухонные записки",
  description = "Личный архив способов, ингредиентов и наблюдений.",
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
